# SABI-RAY alpha: copy to .env. Never commit the completed .env.
PUBLIC_DOMAIN=panel.example.com
SABI_ADMIN_USER=owner
# REQUIRED at first initialization only. 16+ characters, <=72 UTF-8 bytes, 2 upper/2 lower/2 digits and an accepted symbol.
# Generate and save securely, e.g. with a password manager. No fixed password supplied.
SABI_INITIAL_PASSWORD=
SABI_PROFILES=vless-ws,trojan-ws,vmess-ws
# Optional alpha profiles: vless-upgrade,vless-xhttp
SABI_CONTROL_ONLY=false
DEPLOY_MODE=docker
PORT=8080
# Railway only: not a workaround or substitute for provider approval.
RAILWAY_APPROVAL_CONFIRMED=false

# Optional DIRECT TCP profiles, NEW VPS/Docker installations only.
# Select before the first start; keep these unchanged on restart.
SABI_ADVANCED=
# SABI_ADVANCED=reality,shadowsocks
# SABI_DIRECT_DOMAIN=direct.example.com
# A TLS 1.3 origin you control or are authorized to use, not the direct endpoint:
# SABI_REALITY_TARGET=origin.example.com:443
# SABI_REALITY_SERVER_NAME=origin.example.com
